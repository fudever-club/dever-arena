# DEVER Arena — copy thành .env rồi điền secret thật. KHÔNG commit .env.
NODE_ENV=production
PORT=8787

# Bắt buộc ở production (server từ chối chạy nếu thiếu).
DEVER_JWT_SECRET=doi-secret-ngau-nhien-dai-o-day

# Chỉ cho domain web gọi API (ví dụ https://arena.fu-dever.vn).
DEVER_CORS_ORIGIN=*

# File DB JSON trong container (đã mount volume dever-data).
DEVER_DB_PATH=/app/server/data/db.json

# Postgres production (docker compose tự đặt qua service db).
# Chạy local có Postgres riêng thì điền URL tại đây, API tự migrate + dùng thay JSON.
# DEVER_DATABASE_URL=postgres://dever:matkhau@localhost:5432/dever_arena
DEVER_DB_PASSWORD=doi-mat-khau-db-o-day
