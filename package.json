{
  "name": "dever-arena",
  "version": "1.0.0",
  "description": "Nền tảng thi đấu giải thuật nội bộ chuẩn Codeforces của CLB FU-DEVER",
  "type": "module",
  "scripts": {
    "postinstall": "git config commit.template .gitmessage && git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "npx serve dist -l 3000",
    "server": "node server/index.js",
    "gen:openapi": "node scripts/gen_openapi.mjs",
    "test": "node scripts/run_tests.mjs",
    "test:browser": "node --test tests/spa_e2e.test.js tests/a11y_axe.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:load": "node scripts/load_test.mjs",
    "lint": "node detect.mjs",
    "lint:js": "eslint server/ src/ scripts/ tests/ detect.mjs eslint.config.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "audit:high": "npm audit --audit-level=high"
  },
  "author": "CLB FU-DEVER",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "katex": "^0.18.7",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  }
}
