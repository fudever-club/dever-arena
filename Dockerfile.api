# DEVER Arena API — production image (Node + judge toolchains).
# Judge chạy code thật nên image gồm: python3, JDK 17 (javac/java), g++.
FROM node:22-alpine

RUN apk add --no-cache python3 openjdk17 g++ \
  && ln -sf python3 /usr/bin/python

WORKDIR /app
# setup_git_hooks.mjs phải có sẵn TRƯỚC npm ci (postinstall gọi nó) — file này
# tự exit 0 trong container nên không ảnh hưởng runtime, chỉ để npm ci không chết.
COPY scripts/setup_git_hooks.mjs ./scripts/setup_git_hooks.mjs
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server/ ./server/
COPY scripts/ ./scripts/
COPY src/core/ ./src/core/
COPY src/engine/ ./src/engine/
COPY src/data/ ./src/data/

ENV NODE_ENV=production \
    PORT=8787

VOLUME ["/app/server/data"]
EXPOSE 8787

# DEVER_JWT_SECRET bắt buộc ở production (thiếu → server từ chối khởi động).
CMD ["node", "server/index.js"]
