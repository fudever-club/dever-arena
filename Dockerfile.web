# DEVER Arena Web — build SPA rồi phục vụ bằng nginx, proxy /api sang api.
FROM node:22-alpine AS build
WORKDIR /app
# setup_git_hooks.mjs phải có sẵn TRƯỚC npm ci (postinstall gọi nó) — file này
# tự exit 0 trong container nên không ảnh hưởng runtime, chỉ để npm ci không chết.
COPY scripts/setup_git_hooks.mjs ./scripts/setup_git_hooks.mjs
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# manifest.json nằm ở root repo (hợp đồng với legacy HTML + PWA), copy tay vào image.
COPY --from=build /app/manifest.json /usr/share/nginx/html/manifest.json
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
